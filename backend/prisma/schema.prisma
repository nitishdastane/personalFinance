generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BankAccount {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions              BankTransaction[]
  outgoingTransfers         TransferMatch[]   @relation("TransferSourceAccount")
  incomingTransfers         TransferMatch[]   @relation("TransferTargetAccount")
  creditCardPayments        TransferMatch[]   @relation("CreditCardPaymentFrom")
}

model CreditCard {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions       CreditCardTransaction[]
  transferMatches    TransferMatch[]
}

model BankTransaction {
  id                  String   @id @default(cuid())
  bankAccountId       String
  categoryId          String?  // Optional category for transfers and expense categorization
  transactionDate     DateTime
  transactionDetails  String
  debitAmount         Float?
  creditAmount        Float?
  balance             Float
  fingerprint         String   // SHA-256 hash of unique fields
  createdAt           DateTime @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, fingerprint])
  @@index([bankAccountId])
  @@index([transactionDate])
  @@index([categoryId])
}

model CreditCardTransaction {
  id                  String   @id @default(cuid())
  creditCardId        String
  categoryId          String?  // Optional category for transfers and expense categorization
  transactionDate     DateTime
  transactionDetails  String
  amount              Float
  type                String   // "Debit" or "Credit"
  fingerprint         String   // SHA-256 hash of unique fields
  createdAt           DateTime @default(now())

  creditCard CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)

  @@unique([creditCardId, fingerprint])
  @@index([creditCardId])
  @@index([transactionDate])
  @@index([categoryId])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String   // "income", "expense", or "transfer"
  icon        String?  // emoji or icon name
  color       String?  // hex color code
  isDefault   Boolean  @default(false) // true for pre-defined categories
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
}

model TransferPattern {
  id                String   @id @default(cuid())
  pattern           String   @unique // e.g., "NITISH ICICI", "NITISHSBI"
  targetBankName    String   // e.g., "ICICI", "SBI" - used to match BankAccount name
  description       String?  // e.g., "Transfer to ICICI via Nitish"
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive])
}

model TransferMatch {
  id                    String   @id @default(cuid())
  sourceBankAccountId   String?
  sourceTransactionId   String
  targetBankAccountId   String?
  targetBankAccountId2  String?  // For credit card payments: bank account sending payment
  targetCreditCardId    String?  // For credit card payments: credit card receiving payment
  targetTransactionId   String
  amount                Float
  transactionDate       DateTime
  patternMatched        String?
  detectionMethod       String   // "pattern", "amount_date", or "credit_card_payment"
  createdAt             DateTime @default(now())

  sourceBankAccount     BankAccount? @relation("TransferSourceAccount", fields: [sourceBankAccountId], references: [id], onDelete: Cascade)
  targetBankAccount     BankAccount? @relation("TransferTargetAccount", fields: [targetBankAccountId], references: [id], onDelete: Cascade)
  paymentFromAccount    BankAccount? @relation("CreditCardPaymentFrom", fields: [targetBankAccountId2], references: [id], onDelete: Cascade)
  targetCreditCard      CreditCard? @relation(fields: [targetCreditCardId], references: [id], onDelete: Cascade)

  @@unique([sourceTransactionId, targetTransactionId])
  @@index([sourceBankAccountId])
  @@index([targetBankAccountId])
  @@index([targetBankAccountId2])
  @@index([targetCreditCardId])
  @@index([transactionDate])
}

